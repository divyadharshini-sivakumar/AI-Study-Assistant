# ============================================================
# AI Study Assistant - .gitignore
# ============================================================

# Environment & secrets
.env
.env.local
.env.*.local
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Streamlit
.streamlit/secrets.toml
.streamlit/config.toml

# Project-specific data (never commit uploaded materials or the vector DB)
data/
!data/.gitkeep
chroma_db/
!chroma_db/.gitkeep
reports/
!reports/.gitkeep
assets/uploads/
*.pdf
!assets/.gitkeep

# Temporary / cache
*.tmp
*.temp
.cache/
.DS_Store
Thumbs.db
*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
.AppleDouble
.LSOverride
