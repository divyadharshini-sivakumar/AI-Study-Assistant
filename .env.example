# ============================================================
# AI Study Assistant - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# OpenRouter API Key (required)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: preferred free model on OpenRouter
# Recommended free options (as of 2026):
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-2-9b-it:free
#   mistralai/mistral-7b-instruct:free
#   qwen/qwen-2.5-7b-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional overrides (defaults are already good for free tier)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1024

# Local embedding model (free, runs offline)
# Keep this unless you have a strong reason to change it
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Collection name inside ChromaDB
CHROMA_COLLECTION_NAME=study_materials

# Chunking settings (tuned for free-tier context windows)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval settings
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# App behaviour
MAX_UPLOAD_SIZE_MB=25
ENABLE_AGENT_LOGGING=true
